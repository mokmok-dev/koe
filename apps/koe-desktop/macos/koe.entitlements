<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- A hardened-runtime signature denies audio input to a process without
     this entitlement, before TCC is consulted, so AudioUnitRender returns
     -10863 and no permission prompt appears. -->
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
