<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>koe</string>
    <key>CFBundleDisplayName</key>
    <string>koe</string>
    <key>CFBundleIdentifier</key>
    <string>org.mokmok.koe</string>
    <key>CFBundleVersion</key>
    <string>${KOE_RELEASE_VERSION}</string>
    <key>CFBundleShortVersionString</key>
    <string>${KOE_RELEASE_VERSION}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>koe-desktop</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.6</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 mokmok dev. All rights reserved.</string>
    <!--
      Spec 06: microphone purpose string must be user-visible before the
      first mic capture. Shown by TCC at first access.
    -->
    <key>NSMicrophoneUsageDescription</key>
    <string>koe records your microphone so it can transcribe speech entirely on your device. Nothing is uploaded.</string>
    <!--
      Spec 01/06: system audio (macOS 14.6+ process tap) is a separate
      capture source from the microphone and gets its own declaration.
    -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>koe records system audio on your device so it can transcribe what you play. Nothing is uploaded.</string>
    <!-- Network access is not granted by the bundle. Explicit model installs
         remain governed by the application network policy. -->
</dict>
</plist>
