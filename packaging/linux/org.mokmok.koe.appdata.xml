  <name>koe</name>
  <summary>Fully offline recording and transcription</summary>
  <description>
    <p>
      koe records your microphone and system audio and transcribes speech
      with a locally acquired ASR model. Everything — capture, inference and
      storage — happens on your device with no network access during a
      session.
    </p>
    <p>Features:</p>
    <ul>
      <li>Microphone and system audio capture (PipeWire/PulseAudio/ALSA)</li>
      <li>Offline streaming transcription with Nemotron models via Foundry Local</li>
      <li>Session library, segmentation, crash recovery and retention policy</li>
      <li>CLI, GPUI desktop and MCP stdio interfaces</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.mokmok.koe.desktop</launchable>
